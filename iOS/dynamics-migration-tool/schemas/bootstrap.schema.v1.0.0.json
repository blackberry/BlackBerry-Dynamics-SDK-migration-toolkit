{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://blackberry.com/dynamics/migration/ios/bootstrap.schema.v1.0.0.json",
  "title": "iOS Migration Tool Bootstrap Schema",
  "description": "Run-provenance artifact written by tooling/bootstrap.sh before analysis begins. Stable input for all subsequent prompts.",
  "type": "object",
  "required": [
    "schemaVersion",
    "platform",
    "toolkitVersion",
    "runId",
    "createdAt",
    "projectRoot",
    "outputDirectory",
    "buildEntrypoint",
    "sdkIntegration",
    "buildScheme",
    "uemValues",
    "developerAttestations",
    "sourceControl",
    "lifecycleCandidates",
    "backgroundCandidates",
    "extensionCandidates",
    "agentType",
    "executedPrompts",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "platform": {
      "type": "string",
      "const": "ios"
    },
    "toolkitVersion": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "description": "UUID or timestamp-based stable run identifier. Shared across all artifacts in this migration run."
    },
    "createdAt": {
      "type": "string",
      "description": "ISO-8601 UTC timestamp when bootstrap was created."
    },
    "projectRoot": {
      "type": "string",
      "minLength": 1
    },
    "outputDirectory": {
      "type": "string",
      "minLength": 1
    },
    "buildEntrypoint": {
      "type": "object",
      "required": ["type", "reason"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["workspace", "project", "unresolved"]
        },
        "path": {
          "type": ["string", "null"]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "sdkIntegration": {
      "type": "object",
      "required": ["mode", "evidence", "confidence"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["cocoapods", "spm", "manual", "unresolved"]
        },
        "evidence": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        }
      }
    },
    "buildScheme": {
      "type": "object",
      "required": ["resolved", "name", "resolutionMethod"],
      "properties": {
        "resolved": { "type": "boolean" },
        "name": { "type": ["string", "null"] },
        "resolutionMethod": {
          "type": "string",
          "enum": ["user-provided", "auto-detected", "not-attempted", "failed"]
        }
      }
    },
    "uemValues": {
      "type": "object",
      "required": ["gdApplicationId", "gdApplicationVersion", "provenance"],
      "properties": {
        "gdApplicationId": { "type": ["string", "null"] },
        "gdApplicationVersion": { "type": ["string", "null"] },
        "applicationSetupType": {
          "type": ["string", "null"],
          "enum": ["in-house", "partner-third-party", "blackberry-developed", null],
          "description": "Prompt 02 records which public Dynamics setup type controls the second discovery URL scheme."
        },
        "provenance": {
          "type": "string",
          "enum": ["developer-provided", "inferred-from-plist", "not-set"]
        }
      }
    },
    "developerAttestations": {
      "type": "object",
      "required": ["confirmedCleanBuild", "confirmedSourceControlBaseline", "notes"],
      "properties": {
        "confirmedCleanBuild": {
          "type": "string",
          "enum": ["yes", "no", "not-asked"]
        },
        "confirmedSourceControlBaseline": {
          "type": "string",
          "enum": ["yes", "no", "not-asked"]
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "sourceControl": {
      "type": "object",
      "required": ["commit", "branch", "isDirty"],
      "properties": {
        "commit": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "isDirty": { "type": "boolean" }
      }
    },
    "lifecycleCandidates": {
      "type": "array",
      "description": "Lifecycle entry-point candidates discovered during bootstrap or prompt 00.",
      "items": {
        "type": "object",
        "required": ["type", "file"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "UIApplicationDelegate",
              "UISceneDelegate",
              "SwiftUI-main",
              "UIApplicationDelegateAdaptor",
              "storyboard-driven",
              "other"
            ]
          },
          "file": { "type": "string" },
          "symbol": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "backgroundCandidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "file"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["BGTaskScheduler", "APNs-silent", "background-fetch", "other"]
          },
          "file": { "type": "string" },
          "symbol": { "type": "string" }
        }
      }
    },
    "extensionCandidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["targetName", "extensionType"],
        "properties": {
          "targetName": { "type": "string" },
          "extensionType": { "type": "string" }
        }
      }
    },
    "agentType": {
      "type": "string",
      "enum": ["cursor", "kiro", "generic"]
    },
    "executedPrompts": {
      "type": "array",
      "description": "Written exclusively by tooling/record-prompt-execution.sh. Do not edit manually.",
      "items": {
        "type": "object",
        "required": ["promptId", "status", "runId", "recordedAt"],
        "properties": {
          "promptId": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["completed", "not-applicable", "blocked", "failed"]
          },
          "runId": { "type": "string" },
          "recordedAt": { "type": "string" },
          "validationProofFile": { "type": ["string", "null"] },
          "validationProof": {
            "type": "object",
            "required": ["file", "fingerprint", "validationRunId", "mode", "status", "phases", "diagnosticContractVersion"],
            "properties": {
              "file": { "type": "string" },
              "fingerprint": { "type": "string" },
              "validationRunId": { "type": ["string", "null"] },
              "mode": { "type": ["string", "null"] },
              "scope": { "type": ["string", "null"] },
              "status": { "type": ["string", "null"] },
              "phases": {
                "type": "array",
                "items": { "type": "string" }
              },
              "diagnosticContractVersion": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          },
          "notes": { "type": ["string", "null"] }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["generatedBy", "toolkitVersion"],
      "properties": {
        "generatedBy": { "type": "string" },
        "toolkitVersion": { "type": "string" }
      }
    }
  },
  "additionalProperties": true
}
