{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://blackberry.com/dynamics/migration/ios/migration-plan-state.schema.v1.0.0.json",
  "title": "iOS Migration Plan State Schema",
  "description": "Per-call-site closure ledger. Written by domain prompts; enforced by the recorder and validator. Every call site discovered in migration-analysis.json must have exactly one active disposition before prompt 10 can succeed.",
  "type": "object",
  "required": [
    "schemaVersion",
    "platform",
    "runId",
    "updatedAt",
    "dispositions"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "platform": {
      "type": "string",
      "const": "ios"
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "description": "Must match bootstrap.json runId."
    },
    "updatedAt": {
      "type": "string",
      "description": "ISO-8601 timestamp of last update."
    },
    "dispositions": {
      "type": "array",
      "description": "One entry per call site. Duplicate active dispositions for the same callSiteId fail validation.",
      "items": {
        "$ref": "#/definitions/callSiteDisposition"
      }
    }
  },
  "definitions": {
    "callSiteDisposition": {
      "type": "object",
      "required": [
        "callSiteId",
        "domainId",
        "promptId",
        "status",
        "evidence",
        "timestamp",
        "runId"
      ],
      "properties": {
        "callSiteId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ID from migration-analysis.json executionPlan[].callSites[].id. Unknown IDs fail validation."
        },
        "domainId": {
          "type": "string",
          "enum": [
            "authorization",
            "secureFileStorage",
            "secureSql",
            "secureCoreData",
            "secureSwiftData",
            "secureNetworking",
            "webview",
            "icc",
            "dlpPasteboard",
            "policyManagement",
            "backgroundAuthorize",
            "push"
          ]
        },
        "promptId": {
          "type": "string",
          "description": "Prompt that owns this disposition. Prompts may only update their owned domain rows."
        },
        "status": {
          "type": "string",
          "enum": ["migrated", "removed", "blocked", "deferred", "notApplicable"],
          "description": "migrated: source now uses Dynamics-backed pattern. removed: call path deleted. blocked: cannot proceed — blocks final report. deferred: allowed only with schema-approved rationale. notApplicable: proven irrelevant with evidence."
        },
        "evidence": {
          "type": "object",
          "description": "Proof of disposition.",
          "properties": {
            "changedFiles": {
              "type": "array",
              "items": { "type": "string" }
            },
            "proofOfRemoval": {
              "type": ["string", "null"]
            },
            "validationResult": {
              "type": ["string", "null"],
              "description": "Reference to .last-check.json or validation phase output."
            },
            "notes": {
              "type": ["string", "null"]
            }
          }
        },
        "rationale": {
          "type": ["string", "null"],
          "description": "Required for blocked, deferred, or notApplicable dispositions."
        },
        "timestamp": {
          "type": "string"
        },
        "runId": {
          "type": "string",
          "description": "Must match current run. Cross-run dispositions fail validation."
        }
      },
      "if": {
        "properties": {
          "status": { "enum": ["blocked", "deferred", "notApplicable"] }
        }
      },
      "then": {
        "required": ["rationale"]
      }
    }
  },
  "additionalProperties": false
}
