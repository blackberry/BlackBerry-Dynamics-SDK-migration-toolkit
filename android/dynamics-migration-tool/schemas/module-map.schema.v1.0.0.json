{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "module-map.schema.v1.0.0.json",
  "title": "Dynamics Migration Module Map v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "conventionPlugins",
    "discoveryMethod",
    "excludedTestOnlyModules",
    "generatedAt",
    "libraryModulesInScope",
    "otherAppModules",
    "outOfScopeModules",
    "primaryAppModule",
    "projectShape",
    "schemaVersion",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "projectShape": {
      "type": "string",
      "enum": [
        "single-module",
        "multi-module"
      ]
    },
    "discoveryMethod": {
      "type": "string",
      "enum": [
        "fallback-app-dir",
        "settings-gradle-parse",
        "user-supplied"
      ]
    },
    "primaryAppModule": {
      "$ref": "#/$defs/appModule"
    },
    "otherAppModules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "applicationId",
          "inScope",
          "name",
          "path",
          "reason"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "applicationId": {
            "type": [
              "string",
              "null"
            ]
          },
          "inScope": {
            "type": "boolean",
            "const": false
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "libraryModulesInScope": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "buildFile",
          "buildFileType",
          "containsRelevantApis",
          "conventionPluginRef",
          "edgeKind",
          "name",
          "path",
          "reachableFromPrimary",
          "sourceSets",
          "transitiveDepth"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "buildFile": {
            "type": "string",
            "minLength": 1
          },
          "buildFileType": {
            "type": "string",
            "enum": [
              "direct",
              "convention-plugin"
            ]
          },
          "conventionPluginRef": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/conventionPluginRef"
              }
            ]
          },
          "edgeKind": {
            "type": "string",
            "enum": [
              "implementation",
              "api",
              "compileOnly",
              "runtimeOnly"
            ]
          },
          "transitiveDepth": {
            "type": "integer",
            "minimum": 1
          },
          "reachableFromPrimary": {
            "type": "boolean",
            "const": true
          },
          "sourceSets": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/sourceSet"
            }
          },
          "containsRelevantApis": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "sqlite",
                "filesystem",
                "http",
                "webview",
                "icc",
                "uiWidgets",
                "sharedPreferences",
                "clipboard"
              ]
            },
            "uniqueItems": true
          }
        }
      }
    },
    "outOfScopeModules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "reason"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "enum": [
              "convention-plugin-host",
              "kmp-module-ignored",
              "not-reachable-from-primary",
              "composite-build-submodule"
            ]
          }
        }
      }
    },
    "excludedTestOnlyModules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "reachedVia"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "reachedVia": {
            "type": "string",
            "enum": [
              "testImplementation",
              "androidTestImplementation",
              "testApi",
              "androidTestApi",
              "testCompileOnly",
              "androidTestCompileOnly",
              "testRuntimeOnly",
              "androidTestRuntimeOnly"
            ]
          }
        }
      }
    },
    "conventionPlugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "appliesAndroidPlugin",
          "consumedBy",
          "editStrategy",
          "pluginId",
          "sourceFile"
        ],
        "properties": {
          "pluginId": {
            "type": "string",
            "minLength": 1
          },
          "sourceFile": {
            "type": "string",
            "minLength": 1
          },
          "appliesAndroidPlugin": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "enum": [
                  "com.android.application",
                  "com.android.library"
                ]
              }
            ]
          },
          "consumedBy": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "editStrategy": {
            "type": "string",
            "enum": [
              "edit-convention-plugin",
              "override-in-app-module",
              "not-applicable"
            ]
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "appModule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apkOutputGlob",
        "applicationId",
        "buildFile",
        "buildFileType",
        "conventionPluginRef",
        "name",
        "path",
        "settingsJsonPlacement",
        "sourceSets"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "applicationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "buildFile": {
          "type": "string",
          "minLength": 1
        },
        "buildFileType": {
          "type": "string",
          "enum": [
            "direct",
            "convention-plugin"
          ]
        },
        "conventionPluginRef": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/conventionPluginRef"
            }
          ]
        },
        "apkOutputGlob": {
          "type": "string",
          "minLength": 1
        },
        "settingsJsonPlacement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy",
            "targets"
          ],
          "properties": {
            "strategy": {
              "type": "string",
              "enum": [
                "main-only",
                "per-flavor"
              ]
            },
            "targets": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "sourceSets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceSet"
          }
        }
      }
    },
    "sourceSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assets",
        "javaRoots",
        "kotlinRoots",
        "manifest",
        "name",
        "res"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "javaRoots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "kotlinRoots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "manifest": {
          "type": [
            "string",
            "null"
          ]
        },
        "res": {
          "type": [
            "string",
            "null"
          ]
        },
        "assets": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "conventionPluginRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appliesAndroidPlugin",
        "consumedBy",
        "editStrategy",
        "pluginId",
        "sourceFile"
      ],
      "properties": {
        "pluginId": {
          "type": "string",
          "minLength": 1
        },
        "sourceFile": {
          "type": "string",
          "minLength": 1
        },
        "appliesAndroidPlugin": {
          "type": "string",
          "enum": [
            "com.android.application",
            "com.android.library"
          ]
        },
        "consumedBy": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "editStrategy": {
          "type": "string",
          "enum": [
            "edit-convention-plugin",
            "override-in-app-module"
          ]
        }
      }
    }
  }
}
