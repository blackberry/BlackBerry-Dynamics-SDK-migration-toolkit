{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "migration-plan-state.schema.v1.0.0.json",
  "title": "Dynamics Migration Plan State v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "dispositions"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "runId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "callSiteId",
          "domain",
          "status"
        ],
        "properties": {
          "callSiteId": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string",
            "enum": [
              "secureSql",
              "secureFileStorage",
              "secureNetworking"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "migrated",
              "removed"
            ]
          },
          "module": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
